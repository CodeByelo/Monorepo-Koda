# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Connection String (preferred)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=your_postgres_url

# Backward compatibility (deprecated)
SUPABASE_DB_URL=

# Backend Config
BACKEND_PORT=8000
JWT_SECRET=your_ultra_secure_jwt_secret_min_32_chars
DEV_ROLE_MASTER_PASSWORD=your_dev_master_password_min_12_chars

# Keep-alive para evitar cold start de Render (free tier)
# Poner la URL pública del backend en Render, ej: https://koda-backend.onrender.com
# Dejar vacío en desarrollo local.
RENDER_SELF_URL=

# Telegram Bot (opcional)
# El backend usa webhook, no polling: al arrancar, si RENDER_SELF_URL está
# configurada, se registra automáticamente {RENDER_SELF_URL}/webhook/telegram
# como webhook ante la API de Telegram (ver routers/telegram_router.py
# ensure_telegram_webhook). No requiere ejecutar setWebhook a mano en Render.
TELEGRAM_BOT_TOKEN=
