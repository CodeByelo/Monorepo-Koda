# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Connection String (preferred)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=your_postgres_url

# Backward compatibility (deprecated)
SUPABASE_DB_URL=

# Backend Config
BACKEND_PORT=8000
JWT_SECRET=your_ultra_secure_jwt_secret_min_32_chars
DEV_ROLE_MASTER_PASSWORD=your_dev_master_password_min_12_chars

# Keep-alive para evitar cold start de Render (free tier)
# Poner la URL pública del backend en Render, ej: https://koda-backend.onrender.com
# Dejar vacío en desarrollo local.
RENDER_SELF_URL=

# Telegram Bot (opcional)
# El backend usa webhook, no polling: al arrancar, si RENDER_SELF_URL está
# configurada, se registra automáticamente {RENDER_SELF_URL}/webhook/telegram
# como webhook ante la API de Telegram (ver routers/telegram_router.py
# ensure_telegram_webhook). No requiere ejecutar setWebhook a mano en Render.
TELEGRAM_BOT_TOKEN=

# Secreto del webhook de Telegram (parámetro secret_token de setWebhook).
# OBLIGATORIO si TELEGRAM_BOT_TOKEN está configurado: sin esto, POST
# /webhook/telegram no puede validar que la petición viene realmente de
# Telegram y cualquiera en internet podría forjar un update falso. Mínimo 32
# caracteres, sin valor por defecto. Generar con, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your_ultra_secure_telegram_webhook_secret_min_32_chars

# Integración del bot con koda-frontend/backend (servicio Render distinto,
# "koda-backend-contable"). El bot de Telegram de ESTE backend llama a
# {KODA_FRONTEND_API_URL}/bot/venta, /bot/stock y /bot/alertas por HTTP.
# Dejar vacío deshabilita esas funciones (fallan explícitamente, sin crash).
KODA_FRONTEND_API_URL=

# Secreto compartido para autenticar las llamadas bot -> koda-frontend/backend
# via header X-Bot-Api-Key. DEBE configurarse con el MISMO valor en las
# variables de entorno de Render de AMBOS backends. Sin valor por defecto.
BOT_INTERNAL_API_KEY=

# Secreto compartido, en la dirección INVERSA a BOT_INTERNAL_API_KEY: aquí
# koda-frontend/backend es quien LLAMA a este backend en
# PUT /internal/organizations/{tenant_id}/name (routers/internal_router.py,
# header X-Internal-Api-Key) para sincronizar el nombre comercial de la
# Empresa del ERP hacia `organizations.name` de este sistema institucional.
# DEBE configurarse con el MISMO valor en las variables de entorno de Render
# de AMBOS backends. Mínimo 32 caracteres, sin valor por defecto. Generar con,
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORG_SYNC_API_KEY=

# --- Reenvío de webhook de logística (este backend -> koda-frontend/backend) ---
# Cuando un chofer responde por Telegram, este backend reenvía ese update a
# POST /api/logistica/telegram-webhook de koda-frontend/backend (ver
# routers/telegram_router.py). LOGISTICS_WEBHOOK_URL es la URL pública completa
# de ese endpoint en el otro backend (servicio Render "koda-backend-contable").
# Si no está configurada, usa un default de localhost que en producción falla
# en silencio (no reenvía, sin crashear).
LOGISTICS_WEBHOOK_URL=https://koda-backend-contable.onrender.com/api/logistica/telegram-webhook

# Secreto compartido para autenticar el reenvío anterior, vía header
# X-Internal-Forward-Key. DEBE configurarse con el MISMO valor en las variables
# de entorno de Render de AMBOS backends. Obligatorio si TELEGRAM_BOT_TOKEN está
# configurado: mínimo 32 caracteres, sin valor por defecto. El backend rehúsa
# arrancar sin esto. Generar con, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGISTICS_INTERNAL_FORWARD_KEY=your_shared_logistics_forward_key_min_32_chars

# --- Puente de SSO real (este backend -> koda-frontend/backend) ---
# Cuando un usuario ya autenticado en ESTE backend abre el "Módulo de
# Facturación" embebido (BillingModule.tsx en frontend-enterprise, vía GET
# /auth/koda-frontend/exchange-code de routers/auth_router.py), este backend
# llama a POST {KODA_FRONTEND_API_URL}/internal/auth/sso-bridge/issue de
# koda-frontend/backend (ver services/koda_frontend_client.py) para pedir un
# exchange_code de un solo uso a nombre de ese profile_id (misma fila física
# de `profiles`, misma base Postgres). Reusa KODA_FRONTEND_API_URL (ya
# definida arriba para el bot). Secreto compartido, en la dirección INVERSA
# a BOT_INTERNAL_API_KEY, vía header X-SSO-Bridge-Key. Deliberadamente
# PROPIO, distinto de BOT_INTERNAL_API_KEY/ORG_SYNC_API_KEY: este puente
# mintea sesiones de usuario real, no sincroniza datos. DEBE configurarse
# con el MISMO valor en las variables de entorno de Render de AMBOS
# backends. Mínimo 32 caracteres, sin valor por defecto. Generar con, por
# ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SSO_BRIDGE_INTERNAL_KEY=

# Cada cuántas horas se evalúan las reglas de notificaciones_reglas y se
# consulta GET /bot/alertas para notificar a los administradores por Telegram
# (ver core/scheduler.py y services/alertas_notificaciones_service.py).
ALERTAS_NOTIFICACIONES_INTERVAL_HOURS=6

# --- Monitoreo de errores (Sentry) ---
# Crea una cuenta gratuita en https://sentry.io, crea un proyecto Python/FastAPI
# y pega aquí el DSN (Settings > Client Keys). Vacío = Sentry deshabilitado
# (no-op silencioso), que es el estado por defecto.
SENTRY_DSN=
