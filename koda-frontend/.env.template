# KODA ERP — koda-frontend/backend environment variables
# Copiar a ".env" en la raíz de koda-frontend y completar con valores reales.
# NUNCA commitear el archivo ".env" con valores reales (ya está en .gitignore).

# --- Base de datos ---
# Cadena de conexión Postgres (Supabase u otro). Si no se define o no es
# "postgresql://...", el backend cae automáticamente a SQLite local.
DATABASE_URL=your_postgres_connection_url
# Alias legado, aceptado por retrocompatibilidad si DATABASE_URL no está definida.
SUPABASE_DB_URL=

# --- Autenticación / JWT ---
# Obligatorio: mínimo 32 caracteres. El backend rehúsa arrancar sin esto.
SECRET_KEY=your_ultra_secure_jwt_secret_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUDIT_LOG_SECRET=your_audit_log_hmac_secret

# --- Bot de Telegram (servicio externo, koda-frontend/backend/routers/bot_api.py) ---
# Obligatorio para exponer /bot/*: mínimo 32 caracteres. El backend rehúsa
# arrancar sin esto. Es una clave COMPARTIDA (no JWT de usuario): el otro
# backend (KODA_Remaster/sistema-corporativo/backend, deploy independiente
# "monorepo-koda") la envía en el header "X-Bot-Api-Key" en cada llamada
# servidor-a-servidor. Debe configurarse con el MISMO valor en ambos backends.
# Generar con, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_INTERNAL_API_KEY=your_shared_bot_service_key_min_32_chars

# --- Redis (blacklist de tokens / rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase Storage (subida de imágenes de productos) ---
# Requeridas por POST /productos/{id}/imagen (backend/routers/productos.py).
# SUPABASE_URL: URL del proyecto de Supabase, ej. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: clave service_role (NO la anon key) — se usa
# server-side para subir al bucket de Storage. Nunca exponer al frontend.
SUPABASE_URL=your_value_here
SUPABASE_SERVICE_ROLE_KEY=your_value_here
# Nombre del bucket de Storage donde se guardan las imágenes de productos.
# Opcional: por defecto "productos" si se deja vacío.
SUPABASE_STORAGE_BUCKET_PRODUCTOS=productos

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=

# --- Entorno ---
NODE_ENV=development
ENVIRONMENT=development
