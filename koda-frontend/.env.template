# KODA ERP — koda-frontend/backend environment variables
# Copiar a ".env" en la raíz de koda-frontend y completar con valores reales.
# NUNCA commitear el archivo ".env" con valores reales (ya está en .gitignore).

# --- Base de datos ---
# Cadena de conexión Postgres (Supabase u otro). Si no se define o no es
# "postgresql://...", el backend cae automáticamente a SQLite local.
DATABASE_URL=your_postgres_connection_url
# Alias legado, aceptado por retrocompatibilidad si DATABASE_URL no está definida.
SUPABASE_DB_URL=

# --- Autenticación / JWT ---
# Obligatorio: mínimo 32 caracteres. El backend rehúsa arrancar sin esto.
SECRET_KEY=your_ultra_secure_jwt_secret_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUDIT_LOG_SECRET=your_audit_log_hmac_secret

# --- Bot de Telegram (servicio externo, koda-frontend/backend/routers/bot_api.py) ---
# Obligatorio para exponer /bot/*: mínimo 32 caracteres. El backend rehúsa
# arrancar sin esto. Es una clave COMPARTIDA (no JWT de usuario): el otro
# backend (KODA_Remaster/sistema-corporativo/backend, deploy independiente
# "monorepo-koda") la envía en el header "X-Bot-Api-Key" en cada llamada
# servidor-a-servidor. Debe configurarse con el MISMO valor en ambos backends.
# Generar con, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_INTERNAL_API_KEY=your_shared_bot_service_key_min_32_chars

# --- Sincronización de nombre de organización (koda-frontend/backend -> KODA_Remaster) ---
# Cuando un Admin/CEO actualiza el "Nombre Comercial Público" en Perfil de
# Empresa (routers/entidades.py PUT /entidades/empresa/perfil), este backend
# propaga ese nombre hacia `organizations.name` de
# KODA_Remaster/sistema-corporativo/backend (deploy independiente), vía
# PUT {KODA_REMASTER_API_URL}/internal/organizations/{tenant_id}/name.
# URL base pública de ese backend. Ejemplo de valor documentado (ya usado como
# origen CORS de este mismo backend, ver backend/main.py):
# https://monorepo-koda.onrender.com
# Dejar vacío deshabilita la sincronización (falla silenciosamente en el
# guardado local, sin bloquear ni afectar el resto del ERP).
KODA_REMASTER_API_URL=

# Secreto compartido para autenticar la llamada saliente anterior, vía header
# X-Internal-Api-Key. DEBE configurarse con el MISMO valor en las variables
# de entorno de Render de AMBOS backends. Mínimo 32 caracteres, sin valor por
# defecto. Generar con, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ORG_SYNC_API_KEY=your_shared_org_sync_service_key_min_32_chars

# --- Reenvío de webhook de logística (KODA_Remaster -> koda-frontend/backend) ---
# Cuando un chofer responde por Telegram, KODA_Remaster/sistema-corporativo/backend
# reenvía ese update a POST /api/logistica/telegram-webhook de ESTE backend (ver
# backend/routers/logistica.py, dependencia verify_logistics_forward_key, header
# "X-Internal-Forward-Key"). Obligatorio: mínimo 32 caracteres. El backend rehúsa
# arrancar sin esto. DEBE configurarse con el MISMO valor en las variables de
# entorno de Render de AMBOS backends. Generar con, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGISTICS_INTERNAL_FORWARD_KEY=your_shared_logistics_forward_key_min_32_chars

# --- Redis (blacklist de tokens / rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase Storage (subida de imágenes de productos) ---
# Requeridas por POST /productos/{id}/imagen (backend/routers/productos.py).
# SUPABASE_URL: URL del proyecto de Supabase, ej. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: clave service_role (NO la anon key) — se usa
# server-side para subir al bucket de Storage. Nunca exponer al frontend.
SUPABASE_URL=your_value_here
SUPABASE_SERVICE_ROLE_KEY=your_value_here
# Nombre del bucket de Storage donde se guardan las imágenes de productos.
# Opcional: por defecto "productos" si se deja vacío.
SUPABASE_STORAGE_BUCKET_PRODUCTOS=productos

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=

# --- Entorno ---
NODE_ENV=development
ENVIRONMENT=development

# --- Monitoreo de errores (Sentry) ---
# Backend (koda-frontend/backend): crea una cuenta gratuita en https://sentry.io,
# crea un proyecto Python/FastAPI y pega aquí el DSN (Settings > Client Keys).
# Vacío = Sentry deshabilitado (no-op silencioso), que es el estado por defecto.
SENTRY_DSN=
# Frontend (Vite/React, koda-frontend/src): mismo flujo, proyecto tipo React.
# Vacío = Sentry deshabilitado en el navegador.
VITE_SENTRY_DSN=
