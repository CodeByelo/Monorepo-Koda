{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "references": [
    { "path": "./KODA_Remaster/sistema-corporativo/frontend-enterprise" },
    { "path": "./koda-frontend" }
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/backend"
  ]
}
